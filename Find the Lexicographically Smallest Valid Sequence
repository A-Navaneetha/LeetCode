import java.util.Arrays;

class Solution {
    public int[] validSequence(String word1, String String word2) {
        int n = word1.length();
        int m = word2.length();

        int[] last = new int[m];
        Arrays.fill(last, -1);

        int ptr = n - 1;
        for (int j = m - 1; j >= 0; j--) {
            while (ptr >= 0 && word1.charAt(ptr) != word2.charAt(j)) {
                ptr--;
            }
            if (ptr < 0) break;
            last[j] = ptr;
            ptr--;
        }

        int[] ans = new int[m];
        boolean changed = false;
        int j = 0;

        for (int i = 0; i < n && j < m; i++) {
            boolean isMatch = (word1.charAt(i) == word2.charAt(j));

            if (isMatch) {
                ans[j] = i;
                j++;
            } else if (!changed) {
                if (j + 1 == m || (i + 1 <= last[j + 1])) {
                    ans[j] = i;
                    changed = true;
                    j++;
                }
            }
        }

        return j == m ? ans : new int[0];
    }
}
