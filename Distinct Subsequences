class Solution:
    def numDistinct(self, s: str, t: str) -> int:
        a, b = len(s), len(t)
        if a < b:
            return 0
        dp = [0] * (b + 1)
        dp[0] = 1 
        for chars in s:
            for j in range(b, 0, -1):
                if chars == t[j - 1]:
                    dp[j] += dp[j - 1]
        return dp[b]
