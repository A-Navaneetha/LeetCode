class Solution {
    public int[] sortArray(int[] nums) {
        int n = nums.length;
        for (int i = n / 2 - 1; i >= 0; i--) {
            maxHeapify(nums, n, i);
        }
        for (int i = n - 1; i > 0; i--) {
            int temp = nums[0];
            nums[0] = nums[i];
            nums[i] = temp;
            maxHeapify(nums, i, 0);
        }
        return nums;
    }

    private void maxHeapify(int[] nums, int heapSize, int rootIdx) {
        int l = rootIdx; 
        int lChild = 2 * rootIdx + 1; 
        int rChild = 2 * rootIdx + 2; 
        if (lChild < heapSize && nums[lChild] > nums[l]) {
            l = lChild;
        }
        if (rChild < heapSize && nums[rChild] > nums[l]) {
            l = rChild;
        }
        if (l != rootIdx) {
            int swap = nums[rootIdx];
            nums[rootIdx] = nums[l];
            nums[l] = swap;
            maxHeapify(nums, heapSize, l);
        }
    }
}
