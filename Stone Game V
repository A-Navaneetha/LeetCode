import java.util.Arrays;
class Solution {
    private int[][] m;
    private int[] prefixSum;
    public int stoneGameV(int[] stoneValue) {
        int n = stoneValue.length;
        m = new int[n][n];
        for (int[] row : m) {
            Arrays.fill(row, -1);
        }
        prefixSum = new int[n + 1];
        for (int i = 0; i < n; i++) {
            prefixSum[i + 1] = prefixSum[i] + stoneValue[i];
        }
        return solve(0, n - 1);
    }

    private int solve(int i, int j) {
        if (i == j) {
            return 0;
        }
        if (m[i][j] != -1) {
            return m[i][j];
        }
        int maxScore = 0;
        for (int k = i; k < j; k++) {
            int lSum = prefixSum[k + 1] - prefixSum[i];
            int rSum = prefixSum[j + 1] - prefixSum[k + 1];
            if (lSum < rSum) {
                maxScore = Math.max(maxScore, lSum + solve(i, k));
            } else if (lSum > rSum) {
                maxScore = Math.max(maxScore, rSum + solve(k + 1, j));
            } else {
                maxScore = Math.max(maxScore, lSum + Math.max(solve(i, k), solve(k + 1, j)));
            }
        }
        return m[i][j] = maxScore;
    }
}
