class Solution {
    static final long LIMIT = 1000001;
    public String smallestPalindrome(String s, int k) {
        int[] freq = new int[26];
        for (char ch : s.toCharArray()) {
            freq[ch - 'a']++;
        }
        int[] half = new int[26];
        int halfLength = 0;
        char middle = 0;
        for (int i = 0; i < 26; i++) {
            half[i] = freq[i] / 2;
            halfLength += half[i];
            if (freq[i] % 2 == 1) {
                middle = (char) ('a' + i);
            }
        }
        if (countWays(half, halfLength) < k) {
            return "";
        }
        StringBuilder left = new StringBuilder();
        for (int pos = 0; pos < halfLength; pos++) {
            for (int c = 0; c < 26; c++) {
                if (half[c] == 0) continue;
                half[c]--;
                long ways = countWays(half, halfLength - pos - 1);
                if (ways >= k) {
                    left.append((char) ('a' + c));
                    break;
                } else {
                    k -= ways;
                    half[c]++;
                }
            }
        }
        StringBuilder ans = new StringBuilder();
        ans.append(left);
        if (middle != 0) {
            ans.append(middle);
        }
        ans.append(new StringBuilder(left).reverse());
        return ans.toString();
    }
    private long countWays(int[] cnt, int total) {
        long result = 1;
        int remaining = total;
        for (int i = 0; i < 26; i++) {
            if (cnt[i] == 0) continue;
            result *= combination(remaining, cnt[i]);
            if (result > LIMIT) {
                return LIMIT;
            }
            remaining -= cnt[i];
        }
        return Math.min(result, LIMIT);
    }
    private long combination(int n, int r) {
        if (r > n - r) {
            r = n - r;
        }
        long ans = 1;
        for (int i = 1; i <= r; i++) {
            ans = ans * (n - r + i) / i;

            if (ans > LIMIT) {
                return LIMIT;
            }
        }
        return ans;
    }
}
