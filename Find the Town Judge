class Solution {
    public int findJudge(int n, int[][] trust) {
        int[] trustScore = new int[n + 1];
        for (int[] r : trust) {
            int personA = r[0]; 
            int personB = r[1]; 
            trustScore[personA]--; 
            trustScore[personB]++;
        } 
        for (int i = 1; i <= n; i++) {
            if (trustScore[i] == n - 1) {
                return i;
            }
        }
        return -1;
    }
}
