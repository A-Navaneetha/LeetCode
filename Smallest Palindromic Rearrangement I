class Solution {
    public String smallestPalindrome(String s) {
        int[] fre = new int[26];
        for (char ch : s.toCharArray()) {
            fre[ch - 'a']++;
        }
        StringBuilder l = new StringBuilder();
        char mid = 0;
        for (int i = 0; i < 26; i++) {
            for (int j = 0; j < fre[i] / 2; j++) {
                l.append((char) ('a' + i));
            }
            if ((fre[i] & 1) == 1) {
                mid = (char) ('a' + i);
            }
        }
        StringBuilder r= new StringBuilder(l).reverse();
        if (mid != 0) {
            l.append(mid);
        }
        l.append(r);
        return l.toString();
    }
}
