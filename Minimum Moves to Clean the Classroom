import java.util.*;
class Solution {
    public int minMoves(String[] classroom, int maxEnergy) {
        int m = classroom.length;
        int n = classroom[0].length();
        int startX = -1, startY = -1;
        List<int[]> litters = new ArrayList<>();
        for (int r = 0; r < m; r++) {
            for (int c = 0; c < n; c++) {
                char ch = classroom[r].charAt(c);
                if (ch == 'S') {
                    startX = r;
                    startY = c;
                } else if (ch == 'L') {
                    litters.add(new int[]{r, c});
                }
            }
        }
        int numLitters = litters.size();
        if (numLitters == 0) return 0;
        int fullMask = (1 << numLitters) - 1;
        int[][] litterIdx = new int[m][n];
        for (int i = 0; i < m; i++) Arrays.fill(litterIdx[i], -1);
        for (int i = 0; i < numLitters; i++) {
            litterIdx[litters.get(i)[0]][litters.get(i)[1]] = i;
        }
        int[][][] maxEnergyGrid = new int[m][n][1 << numLitters];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                Arrays.fill(maxEnergyGrid[i][j], -1);
            }
        }
        Queue<int[]> queue = new LinkedList<>();
        queue.offer(new int[]{startX, startY, 0, maxEnergy, 0});
        maxEnergyGrid[startX][startY][0] = maxEnergy;

        int[][] dirs = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};

        while (!queue.isEmpty()) {
            int[] curr = queue.poll();
            int r = curr[0], c = curr[1], mask = curr[2], energy = curr[3], steps = curr[4];

            if (energy == 0) continue;

            for (int[] d : dirs) {
                int nr = r + d[0];
                int nc = c + d[1];

                if (nr < 0 || nr >= m || nc < 0 || nc >= n || classroom[nr].charAt(nc) == 'X') {
                    continue;
                }

                int nextEnergy = energy - 1;
                int nextMask = mask;
                char cellType = classroom[nr].charAt(nc);

                if (cellType == 'L') {
                    int idx = litterIdx[nr][nc];
                    nextMask |= (1 << idx);
                } else if (cellType == 'R') {
                    nextEnergy = maxEnergy;
                }

                if (nextMask == fullMask) {
                    return steps + 1;
                }

                if (nextEnergy > maxEnergyGrid[nr][nc][nextMask]) {
                    maxEnergyGrid[nr][nc][nextMask] = nextEnergy;
                    queue.offer(new int[]{nr, nc, nextMask, nextEnergy, steps + 1});
                }
            }
        }
        return -1;
    }
}
