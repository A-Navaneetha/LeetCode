class Solution:
    def largestInteger(self, nums: list[int], k: int) -> int:
        n = len(nums)
        if k == 1:
            freq = {}
            for num in nums:
                freq[num] = freq.get(num, 0) + 1
            ans = -1
            for num, c in freq.items():
                if c == 1:
                    ans = max(ans, num)
            return ans
        if k == n:
            return max(nums)
        c_first = nums.count(nums[0])
        c_last = nums.count(nums[-1])
        ans = -1
        if c_first == 1:
            ans = max(ans, nums[0])
        if c_last == 1:
            ans = max(ans, nums[-1])
        return ans
