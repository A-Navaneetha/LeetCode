class Solution {
    public String stoneGameIII(int[] stoneValue) {
        int n = stoneValue.length;
        int[] dp = new int[4]; 
        for (int i = n - 1; i >= 0; i--) {
            int maxDiff = Integer.MIN_VALUE;
            int curr = 0;
            for (int k = 0; k < 3 && i + k < n; k++) {
                curr += stoneValue[i + k];
                int opp = dp[(i + k + 1) % 4];
                maxDiff = Math.max(maxDiff, curr - opp);
            }
            dp[i % 4] = maxDiff;
        }
        int res = dp[0];
        if (res > 0) return "Alice";
        if (res < 0) return "Bob";
        return "Tie";
    }
}
