class Solution {
    public String smallestNumber(String num, long t) {
        long temp = t;
        int c2 = 0, c3 = 0, c5 = 0, c7 = 0;
        while (temp % 2 == 0) { c2++; temp /= 2; }
        while (temp % 3 == 0) { c3++; temp /= 3; }
        while (temp % 5 == 0) { c5++; temp /= 5; }
        while (temp % 7 == 0) { c7++; temp /= 7; }
        if (temp > 1) return "-1";
        int n = num.length();
        int[] r = new int[]{c2, c3, c5, c7};
        int[][] prefix = new int[n + 1][4];
        prefix[0] = new int[]{c2, c3, c5, c7};
        int firstZero = -1;
        for (int i = 0; i < n; i++) {
            int d = num.charAt(i) - '0';
            if (d == 0) {
                if (firstZero == -1) firstZero = i;
                break;
            }
            int[] prev = prefix[i];
            int r2 = Math.max(0, prev[0] - countFactor(d, 2));
            int r3 = Math.max(0, prev[1] - countFactor(d, 3));
            int r5 = Math.max(0, prev[2] - countFactor(d, 5));
            int r7 = Math.max(0, prev[3] - countFactor(d, 7));
            prefix[i + 1] = new int[]{r2, r3, r5, r7};
        }
        if (firstZero == -1) {
            int[] last = prefix[n];
            if (last[0] == 0 && last[1] == 0 && last[2] == 0 && last[3] == 0) {
                return num;
            }
        }
        int maxLen = (firstZero != -1) ? firstZero : n;
        for (int i = maxLen; i >= 0; i--) {
            int[] curReq = prefix[i];
            int startDigit = (i < n) ? (num.charAt(i) - '0' + 1) : 1;
            for (int d = startDigit; d <= 9; d++) {
                int r2 = Math.max(0, curReq[0] - countFactor(d, 2));
                int r3 = Math.max(0, curReq[1] - countFactor(d, 3));
                int r5 = Math.max(0, curReq[2] - countFactor(d, 5));
                int r7 = Math.max(0, curReq[3] - countFactor(d, 7));
                int minDigits = getMinDigits(r2, r3, r5, r7);
                int remPositions = n - 1 - i;
                if (minDigits <= remPositions) {
                    StringBuilder sb = new StringBuilder();
                    sb.append(num, 0, i);
                    sb.append(d);
                    int onesNeeded = remPositions - minDigits;
                    while (onesNeeded-- > 0) {
                        sb.append('1');
                    }
                    sb.append(buildSuffix(r2, r3, r5, r7));
                    return sb.toString();
                }
            }
        }
        int minDigitsLen = getMinDigits(c2, c3, c5, c7);
        int targetLen = Math.max(n + 1, minDigitsLen);
        StringBuilder sb = new StringBuilder();
        int onesNeeded = targetLen - minDigitsLen;
        while (onesNeeded-- > 0) {
            sb.append('1');
        }
        sb.append(buildSuffix(c2, c3, c5, c7));
        return sb.toString();
    }

    private int countFactor(int n, int p) {
        int count = 0;
        while (n > 0 && n % p == 0) {
            count++;
            n /= p;
        }
        return count;
    }
    private int getMinDigits(int r2, int r3, int r5, int r7) {
        int count = r5 + r7; 
        int d9 = r3 / 2;
        r3 %= 2;
        int d8 = r2 / 3;
        r2 %= 3;
        int d6 = 0;
        if (r3 == 1 && r2 == 1) {
            d6 = 1;
            r3 = 0;
            r2 = 0;
        } else if (r3 == 1 && r2 == 2) {
            d6 = 1;
            r3 = 0;
            r2 = 1;
        }

        int d4 = r2 / 2;
        r2 %= 2;

        return count + d9 + d8 + d6 + d4 + r3 + r2;
    }
    private String buildSuffix(int r2, int r3, int r5, int r7) {
        int d9 = r3 / 2; r3 %= 2;
        int d8 = r2 / 3; r2 %= 3;
        int d6 = 0;
        if (r3 == 1 && r2 == 1) {
            d6 = 1; r3 = 0; r2 = 0;
        } else if (r3 == 1 && r2 == 2) {
            d6 = 1; r3 = 0; r2 = 1;
        }
        int d4 = r2 / 2; r2 %= 2;
        StringBuilder sb = new StringBuilder();
        while (r2-- > 0) sb.append('2');
        while (r3-- > 0) sb.append('3');
        while (d4-- > 0) sb.append('4');
        while (r5-- > 0) sb.append('5');
        while (d6-- > 0) sb.append('6');
        while (r7-- > 0) sb.append('7');
        while (d8-- > 0) sb.append('8');
        while (d9-- > 0) sb.append('9');
        return sb.toString();
    }
}
