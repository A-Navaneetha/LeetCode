class Solution:
    def missingInteger(self, nums: list[int]) -> int:
        seq = nums[0]
        for i in range(1, len(nums)):
            if nums[i] == nums[i - 1] + 1:
                seq += nums[i]
            else:
                break
        num_set = set(nums)
        while seq in num_set:
            seq += 1
        return seq
